<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_interfaz_android"
    android:padding="16dp">

    <ImageView
        android:id="@+id/ivHeaderLogo"
        android:contentDescription="@null"
        android:layout_width="140dp"
        android:layout_height="40dp"
        android:src="@drawable/logo_app_android"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutFiltros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/ivHeaderLogo">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFiltroNuevas"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="16dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/nuevas"
            android:textAllCaps="false"
            android:textColor="#3A75B5"
            android:textSize="12sp"
            app:backgroundTint="#EDF3FB"
            app:cornerRadius="4dp"
            app:paddingEnd="4dp"
            app:paddingStart="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFiltroRecibidas"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/recibidas"
            android:textAllCaps="false"
            android:textColor="#3A75B5"
            android:textSize="12sp"
            app:backgroundTint="#EDF3FB"
            app:cornerRadius="4dp"
            app:paddingEnd="4dp"
            app:paddingStart="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFiltroFinalizadas"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="51dp"
            android:layout_height="51dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/finalizadas"
            android:textAllCaps="false"
            android:textColor="#3A75B5"
            android:textSize="12sp"
            app:backgroundTint="#EDF3FB"
            app:cornerRadius="4dp"
            app:paddingEnd="4dp"
            app:paddingStart="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrarSesion"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="65dp"
            android:layout_height="51dp"
            android:text="@string/salir"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#A40202"
            app:cornerRadius="4dp"
            app:paddingEnd="4dp"
            app:paddingStart="4dp" />
    </LinearLayout>

    <View
        android:id="@+id/divisorLinea"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#D1D1D1"
        app:layout_constraintTop_toBottomOf="@id/layoutFiltros" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAverias"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divisorLinea" />

</androidx.constraintlayout.widget.ConstraintLayout>