<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_interfaz_android"
    android:padding="16dp"
    tools:context=".ui.listado.ListadoAveriasFragment">

    <ImageView
        android:id="@+id/ivHeaderLogo"
        android:layout_width="140dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_app_android"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutFiltros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/ivHeaderLogo">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFiltroNuevas"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:text="@string/nuevas"
            android:textAllCaps="false"
            android:textColor="#3A75B5"
            android:textSize="11sp"
            app:backgroundTint="#EDF3FB"
            app:cornerRadius="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFiltroRecibidas"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1.2"
            android:text="@string/recibidas"
            android:textAllCaps="false"
            android:textColor="#3A75B5"
            android:textSize="11sp"
            app:backgroundTint="#EDF3FB"
            app:cornerRadius="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFiltroFinalizadas"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1.4"
            android:text="@string/finalizadas"
            android:textAllCaps="false"
            android:textColor="#3A75B5"
            android:textSize="11sp"
            app:backgroundTint="#EDF3FB"
            app:cornerRadius="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrarSesion"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="60dp"
            android:text="@string/salir"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#A40202"
            app:cornerRadius="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

    <View
        android:id="@+id/divisorLinea"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:alpha="0.6"
        android:background="#D1D1D1"
        app:layout_constraintTop_toBottomOf="@id/layoutFiltros" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAverias"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divisorLinea"
        tools:listitem="@layout/item_averia" />

</androidx.constraintlayout.widget.ConstraintLayout>