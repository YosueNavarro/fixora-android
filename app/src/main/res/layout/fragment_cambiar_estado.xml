<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_cambiar_estado"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A" />

    <TextView
        android:id="@+id/tvNombreMaquinaActual"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="16sp"
        android:textColor="#666666"
        tools:text="Máquina: Excavadora Volvo" />

    <RadioGroup
        android:id="@+id/rgEstadoMaquina"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">

        <RadioButton
            android:id="@+id/rbAveriada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/estado_averiada"
            android:textSize="16sp"
            android:padding="12dp" />

        <RadioButton
            android:id="@+id/rbMantenimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/estado_mantenimiento"
            android:textSize="16sp"
            android:padding="12dp" />

        <RadioButton
            android:id="@+id/rbFueraServicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/estado_fuera_servicio"
            android:textSize="16sp"
            android:padding="12dp" />

        <RadioButton
            android:id="@+id/rbOperativa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/estado_operativa"
            android:textSize="16sp"
            android:padding="12dp" />
    </RadioGroup>

    <Button
        android:id="@+id/btnGuardarEstadoMaquina"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/btn_actualizar_estado"
        android:backgroundTint="#FFA000"
        android:paddingVertical="12dp" />

</LinearLayout>